# ---- API ----
PORT=3000

# ---- PostgreSQL + PostGIS (docker compose expone 55432 para no chocar con un Postgres local) ----
DATABASE_URL=postgres://lacosta:lacosta_dev@localhost:55432/lacosta
DB_POOL_MAX=20
DB_STATEMENT_TIMEOUT_MS=5000
# Usado por la suite de integración (pnpm test:int). Puede ser la misma base de desarrollo: los tests solo leen.
TEST_DATABASE_URL=postgres://lacosta:lacosta_dev@localhost:55432/lacosta

# ---- Ruteo ----
# straight-line: sin servidor de ruteo (distancia geodésica x factor de desvío), siempre marcado como "degradado".
# osrm: OSRM primario con fallback automático a straight-line + circuit breaker.
ROUTING_PROVIDER=straight-line
OSRM_BASE_URL=http://localhost:5000
ROUTING_TIMEOUT_MS=1500
ROUTING_BREAKER_FAILURES=3
ROUTING_BREAKER_COOLDOWN_MS=30000
STRAIGHT_LINE_DETOUR_FACTOR=1.3
STRAIGHT_LINE_AVG_SPEED_KMH=30

# ---- Geo / tarifas ----
# Distancia máxima (m) para asignar un punto fuera de polígono a la localidad más cercana (zonas rurales entre localidades).
LOCALITY_FALLBACK_MAX_METERS=6000
TARIFF_CACHE_TTL_MS=60000

# ---- Redis (Fase 2) ----
REDIS_URL=redis://localhost:56379
# Base de Redis aparte para la suite de integración (la vacía en cada test).
TEST_REDIS_URL=redis://localhost:56379/15

# ---- Despacho (Fase 2) ----
# Vacío: hostname-pid-aleatorio. Identifica la réplica en leases y en trip_offers.
DISPATCH_INSTANCE_ID=
DISPATCH_WORKERS_ENABLED=true
DISPATCH_OFFER_TIMEOUT_MS=15000
DISPATCH_MAX_OFFERS_PER_ROUND=5
DISPATCH_MAX_SEARCH_MS=180000
DISPATCH_LEASE_TTL_MS=10000
DISPATCH_REJECTION_WINDOW_MS=1800000
DISPATCH_EXPIRE_TICK_MS=1000
DISPATCH_RESUME_TICK_MS=5000
# Presencia del chofer
PRESENCE_STALE_MS=45000
PRESENCE_SWEEP_TICK_MS=10000
PRESENCE_RETURNING_TTL_MS=5400000
PRESENCE_ELIGIBILITY_CACHE_MS=60000
PRESENCE_MAX_SPEED_KMH=180
GEO_INDEX_REFRESH_MS=300000
# Recorrido GPS (Redis Stream → trip_track_points)
TRACKING_BATCH_SIZE=500
TRACKING_STREAM_MAXLEN=200000
