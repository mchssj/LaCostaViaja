{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev:api"],
      "port": 3000,
      "autoPort": false
    },
    {
      "name": "admin-web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@lacosta/admin-web", "dev"],
      "port": 3001,
      "autoPort": false
    },
    {
      "name": "guest-pwa",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@lacosta/guest-pwa", "dev"],
      "port": 3002,
      "autoPort": false
    },
    {
      "name": "driver-web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@lacosta/driver-web", "dev"],
      "port": 3003,
      "autoPort": false
    }
  ]
}
